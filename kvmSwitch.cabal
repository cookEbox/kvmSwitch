cabal-version:      3.4
name:               kvmSwitch
version:            0.1.0.0
-- synopsis:
-- description:
license:            NONE
author:             nj.cooke@outlook.com
maintainer:         Nick Cooke
-- copyright:
build-type:         Simple
extra-doc-files:    CHANGELOG.md
extra-source-files: config/keyboard.yaml

common warnings
    ghc-options: -Wall
    default-extensions: 
      ImportQualifiedPost LambdaCase BlockArguments NumericUnderscores 
      BinaryLiterals DerivingStrategies GeneralizedNewtypeDeriving 
      DeriveFunctor DeriveFoldable DeriveTraversable DeriveGeneric 
      StandaloneDeriving NamedFieldPuns TupleSections 
      TypeOperators KindSignatures StandaloneKindSignatures 
      ScopedTypeVariables BangPatterns ViewPatterns PatternSynonyms 
      DuplicateRecordFields NoFieldSelectors OverloadedRecordDot

library
    import:           warnings
    exposed-modules:  
        Config
      , Board.State
      , Board.Mapping
      , Board.Frame
      , Board.Check
      , Board.Session
      , Scan
      , GPIO.Types
      , GPIO.Error
      , GPIO.PinMap
      , GPIO.FFI
      , GPIO.Libgpiod
      , NeoPixel
      , NeoPixel.Types
      , NeoPixel.Error
      , Keyboard.Keys
      , Keyboard.LED
      , Keyboard.Device
      , Keyboard.Diagnostics
      , Keyboard.Monitor
      , Keyboard.LED.HardwareTest

    other-modules:
        NeoPixel.FFI
    -- other-extensions:
    build-depends:    
        base 
      , text
      , yaml
      , containers
      , edo
      , stm
      , clock
      , filepath 
      , directory
      , time

    hs-source-dirs:   src
    c-sources:        cbits/neopixel_bridge.c
    include-dirs:     cbits
    default-language: GHC2021
    pkgconfig-depends: libgpiod >= 1.6 && < 1.7, libws2811 >= 1.1 && < 1.2
    extra-libraries:   gpiod, m

executable kvmSwitch
    import:           warnings
    main-is:          Main.hs
    -- other-modules:
    -- other-extensions:
    build-depends:
        base 
      , kvmSwitch
      , yaml
      , directory
      , filepath
      , containers
      , edo
      , stm
      
    hs-source-dirs:   app
    default-language: GHC2021

test-suite kvmSwitch-test
    import:           warnings
    default-language: GHC2021
    -- other-modules:
    -- other-extensions:
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    build-depends:
        base 
      , kvmSwitch
